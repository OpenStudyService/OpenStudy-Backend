# Copy to .env in the backend root and replace the local credentials.
# Loaded as Java properties: do not wrap values in quotes or use export.
# Escape literal backslashes as \\.
DB_URL=jdbc:mysql://localhost:3306/openstudy?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=openstudy_app
DB_PASSWORD=CHANGE_ME

# Invitation delivery is disabled unless explicitly enabled. No mail is sent by default.
# Supply real SMTP credentials through your environment/secret store; never commit them.
# openstudy.invitation-mail.enabled=true
# openstudy.invitation-mail.from=no-reply@your-domain.example
# openstudy.invitation-mail.acceptance-url=https://your-domain.example/invitations/accept
# spring.mail.host=smtp.your-provider.example
# spring.mail.port=587
# spring.mail.username=YOUR_SMTP_USERNAME
# spring.mail.password=YOUR_SMTP_SECRET
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# spring.mail.properties.mail.smtp.starttls.required=true
# spring.mail.properties.mail.smtp.connectiontimeout=5000
# spring.mail.properties.mail.smtp.timeout=10000
# spring.mail.properties.mail.smtp.writetimeout=10000
# SMTP debug/protocol tracing can expose tokens or credentials; keep it disabled.
# spring.mail.properties.mail.debug=false
# spring.mail.properties.mail.debug.auth=false
# Technical defaults: batch-size=10, lease-seconds=60, retry-delay-seconds=60,
# max-attempts=5, poll-millis=1000. Automatic retries never extend invitation TTL.

# Optional first owner creation for local development only.
# Uncomment and supply your own credentials, then restart the backend.
# spring.profiles.active=local
# BOOTSTRAP_OWNER_EMAIL=owner@openstudy.example
# BOOTSTRAP_OWNER_PASSWORD=replace-with-your-own-password

# local profile: read-only workspace sample data is enabled by default.
# Set false when replacing the preview with real business APIs.
# openstudy.local-preview.enabled=false
