# Copy to .env in the backend root and replace the local credentials.
# Loaded as Java properties: do not wrap values in quotes or use export.
# Escape literal backslashes as \\.
DB_URL=jdbc:mysql://localhost:3306/openstudy?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=openstudy_app
DB_PASSWORD=CHANGE_ME

# Optional first owner creation for local development only.
# Uncomment and supply your own credentials, then restart the backend.
# spring.profiles.active=local
# BOOTSTRAP_OWNER_EMAIL=owner@openstudy.example
# BOOTSTRAP_OWNER_PASSWORD=replace-with-your-own-password

# local profile: read-only workspace sample data is enabled by default.
# Set false when replacing the preview with real business APIs.
# openstudy.local-preview.enabled=false

# Reverse proxy addresses allowed to set X-Forwarded-For (IPs or CIDRs, comma-separated).
# Leave empty when the backend is reached directly; forwarded headers are then ignored.
# TRUSTED_PROXIES=
