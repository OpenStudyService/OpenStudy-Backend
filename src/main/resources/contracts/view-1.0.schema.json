{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainlens:view:1.0",
  "$ref": "#/$defs/view",
  "$defs": {
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "componentId": {
              "type": "string"
            }
          },
          "required": [
            "componentId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "stack",
                "grid",
                "split"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/layout"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "children"
          ]
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "componentRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ]
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "properties": {},
          "required": []
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "actionId": {
                "enum": [
                  "page",
                  "sort",
                  "drillDetail",
                  "refineFilter",
                  "requestCsv"
                ]
              }
            },
            "required": [
              "event",
              "actionId"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "componentRef",
        "datasetId",
        "bindings",
        "options",
        "events"
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalogVersion": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          },
          "maxItems": 24,
          "minItems": 1
        },
        "layout": {
          "$ref": "#/$defs/container"
        }
      },
      "required": [
        "catalogVersion",
        "components",
        "layout"
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "stack",
            "grid",
            "split"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layout"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "children"
      ]
    }
  }
}
