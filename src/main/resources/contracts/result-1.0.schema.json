{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainlens:result:1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "alias": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "type": {
                  "enum": [
                    "STRING",
                    "INTEGER",
                    "DECIMAL",
                    "BOOLEAN",
                    "DATE",
                    "TIMESTAMP"
                  ]
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "precision": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "alias",
                "type",
                "unit",
                "precision"
              ]
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "totalElements": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "snapshotAt": {
            "type": "string",
            "minLength": 1
          },
          "asOf": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "columns",
          "rows",
          "totalElements",
          "page",
          "size",
          "snapshotAt",
          "asOf"
        ]
      },
      "maxItems": 6
    },
    "view": {
      "anyOf": [
        {
          "$ref": "#/$defs/view"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "asOf": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshotVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "policyVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "formulaBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string"
          },
          "column": {
            "type": "string"
          },
          "formula": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "hash": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version",
              "hash"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "datasetId",
          "column",
          "formula"
        ],
        "additionalProperties": false
      }
    },
    "displayValues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "formula": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "hash": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version",
              "hash"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "datasetId",
          "slot",
          "values",
          "formula"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "requestId",
    "executionId",
    "status",
    "datasets",
    "view",
    "warnings",
    "errorCode",
    "asOf",
    "snapshotVersion",
    "policyVersion"
  ],
  "$defs": {
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "componentId": {
              "type": "string"
            }
          },
          "required": [
            "componentId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "stack",
                "grid",
                "split"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/layout"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "children"
          ]
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "componentRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ]
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "properties": {},
          "required": []
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "actionId": {
                "enum": [
                  "page",
                  "sort",
                  "drillDetail",
                  "refineFilter",
                  "requestCsv"
                ]
              }
            },
            "required": [
              "event",
              "actionId"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "componentRef",
        "datasetId",
        "bindings",
        "options",
        "events"
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalogVersion": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          },
          "maxItems": 24,
          "minItems": 1
        },
        "layout": {
          "$ref": "#/$defs/container"
        }
      },
      "required": [
        "catalogVersion",
        "components",
        "layout"
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "stack",
            "grid",
            "split"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layout"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "children"
      ]
    }
  }
}
