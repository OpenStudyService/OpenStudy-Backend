{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "status": {
      "enum": [
        "READY",
        "NEEDS_CLARIFICATION",
        "UNSUPPORTED"
      ]
    },
    "clarification": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "clarificationOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "maxItems": 3
    },
    "unsupportedReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      },
      "maxItems": 6
    },
    "view": {
      "anyOf": [
        {
          "$ref": "#/$defs/view"
        },
        {
          "type": "null"
        }
      ]
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reasonCode": {
      "anyOf": [
        {
          "enum": [
            "KNOWLEDGE_MISSING",
        "KNOWLEDGE_INSUFFICIENT",
        "REQUEST_INCOMPLETE",
            "METRIC_AMBIGUOUS",
            "REQUIRED_INPUT_MISSING",
            "CAPABILITY_UNSUPPORTED",
            "SEMANTIC_GROUNDING_FAILED",
            "FORMULA_CONFLICT"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "clarification",
    "clarificationOptions",
    "unsupportedReason",
    "queries",
    "view",
    "contextRefs",
    "reasonCode"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainlens:ir:1.1",
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "field",
        "alias"
      ]
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "ASC",
            "DESC"
          ]
        }
      },
      "required": [
        "alias",
        "direction"
      ]
    },
    "filter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "leaf"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": [
                "EQ",
                "NE",
                "IN",
                "GT",
                "GTE",
                "LT",
                "LTE",
                "BETWEEN",
                "IS_NULL"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "maxItems": 50
            }
          },
          "required": [
            "kind",
            "field",
            "operator",
            "values"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "group"
            },
            "junction": {
              "enum": [
                "AND",
                "OR"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/filter"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "junction",
            "children"
          ]
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "grain": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "DETAIL",
            "AGGREGATE",
            "REGISTERED_ANALYSIS"
          ]
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selection"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selection"
          }
        },
        "filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/filter"
            },
            {
              "type": "null"
            }
          ]
        },
        "orderBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/order"
          }
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 0
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "page",
            "size"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "analysisId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "source",
        "grain",
        "mode",
        "dimensions",
        "metrics",
        "filter",
        "orderBy",
        "pagination",
        "limit",
        "analysisId"
      ]
    },
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "componentId": {
              "type": "string"
            }
          },
          "required": [
            "componentId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "stack",
                "grid",
                "split"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/layout"
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "children"
          ]
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "componentRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version"
          ]
        },
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ]
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "properties": {},
          "required": []
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "actionId": {
                "enum": [
                  "page",
                  "sort",
                  "drillDetail",
                  "refineFilter",
                  "requestCsv"
                ]
              }
            },
            "required": [
              "event",
              "actionId"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "componentRef",
        "datasetId",
        "bindings",
        "options",
        "events"
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalogVersion": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          },
          "maxItems": 24,
          "minItems": 1
        },
        "layout": {
          "$ref": "#/$defs/container"
        }
      },
      "required": [
        "catalogVersion",
        "components",
        "layout"
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "stack",
            "grid",
            "split"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layout"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "children"
      ]
    }
  }
}
