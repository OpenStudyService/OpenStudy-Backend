{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:domainlens:components:1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dataSlots": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "types": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "STRING",
                      "INTEGER",
                      "DECIMAL",
                      "BOOLEAN",
                      "DATE",
                      "TIMESTAMP"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "required": {
                  "type": "boolean"
                },
                "multiple": {
                  "type": "boolean"
                },
                "minRows": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxRows": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "types",
                "required",
                "multiple",
                "minRows",
                "maxRows"
              ]
            }
          },
          "optionsSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "object"
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "boolean",
                        "integer",
                        "number"
                      ]
                    },
                    "enum": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "additionalProperties": {
                "const": false
              }
            },
            "required": [
              "type",
              "properties",
              "required",
              "additionalProperties"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "event": {
                  "type": "string",
                  "minLength": 1
                },
                "actionId": {
                  "enum": [
                    "page",
                    "sort",
                    "drillDetail",
                    "refineFilter",
                    "requestCsv"
                  ]
                }
              },
              "required": [
                "event",
                "actionId"
              ]
            },
            "uniqueItems": true
          },
          "composition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "leaf": {
                "const": true
              },
              "parents": {
                "type": "array",
                "items": {
                  "enum": [
                    "stack",
                    "grid",
                    "split"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "leaf",
              "parents"
            ]
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxRows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "maxRows"
            ]
          },
          "accessibility": {
            "type": "string",
            "minLength": 1
          },
          "analysisIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "version",
          "description",
          "dataSlots",
          "optionsSchema",
          "events",
          "composition",
          "limits",
          "accessibility"
        ]
      }
    },
    "compatibleVersions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "catalogVersion",
    "components"
  ]
}
