erDiagram
  branches {
    BIGINT id PK
  }
  employees {
    BIGINT id PK
  }
  branch_memberships {
    BIGINT id PK
    BIGINT employee_id FK
    BIGINT branch_id FK
    BIGINT approved_by FK
  }
  customers {
    BIGINT id PK
    VARCHAR member_no
    VARCHAR name
    VARCHAR phone
    VARCHAR email
    ENUM status
    VARCHAR status_reason
    DATETIME registered_at
    DATETIME updated_at
    BIGINT version
  }
  customer_service_interactions {
    BIGINT id PK
    BIGINT customer_id FK
    BIGINT branch_id FK
    BIGINT employee_id FK
    VARCHAR reason
    DATETIME verified_at
  }
  customer_status_events {
    BIGINT id PK
    BIGINT customer_id FK
    VARCHAR previous_status
    VARCHAR new_status
    VARCHAR reason
    BIGINT actor_employee_id FK
    DATETIME changed_at
  }
  products {
    BIGINT id PK
    VARCHAR code
    VARCHAR name
    ENUM kind
    BIGINT price_krw
    INT included_minutes
    INT period_days
    BIGINT credit_krw
    BIGINT hourly_rate_krw
    INT valid_days
    ENUM sale_status
    DATETIME created_at
    DATETIME updated_at
    BIGINT version
  }
  payments {
    BIGINT id PK
    BIGINT customer_id FK
    BIGINT branch_id FK
    BIGINT product_id FK
    VARCHAR product_name_snapshot
    ENUM purpose
    ENUM method
    BIGINT amount_krw
    ENUM status
    VARCHAR idempotency_key
    DATETIME approved_at
    DATETIME failed_at
    BIGINT created_by FK
    DATETIME created_at
    DATETIME updated_at
    BIGINT version
  }
  passes {
    BIGINT id PK
    BIGINT customer_id FK
    BIGINT product_id FK
    BIGINT purchase_payment_id FK
    BIGINT purchase_branch_id FK
    ENUM kind
    BIGINT snapshot_price_krw
    VARCHAR snapshot_product_name
    INT snapshot_minutes
    INT snapshot_period_days
    BIGINT snapshot_credit_krw
    BIGINT snapshot_hourly_rate_krw
    INT snapshot_valid_days
    INT remaining_minutes
    BIGINT remaining_credit_krw
    ENUM status
    DATETIME started_at
    DATETIME expires_at
    DATETIME created_at
    DATETIME updated_at
    BIGINT version
  }
  refunds {
    BIGINT id PK
    BIGINT payment_id FK
    BIGINT processing_branch_id FK
    BIGINT processed_by FK
    BIGINT amount_krw
    VARCHAR reason
    VARCHAR idempotency_key
    DATETIME refunded_at
  }
  seat_sessions {
    BIGINT id PK
    BIGINT customer_id FK
    BIGINT pass_id FK
    BIGINT branch_id FK
    BIGINT seat_id FK
    BIGINT exception_actor_id FK
  }
  seat_session_corrections {
    BIGINT id PK
    BIGINT seat_session_id FK
    BIGINT actor_employee_id FK
  }
  pass_balance_events {
    BIGINT id PK
    BIGINT pass_id FK
    BIGINT seat_session_id FK
    BIGINT correction_id FK
    ENUM kind
    BIGINT delta_minutes
    BIGINT delta_krw
    BIGINT actor_employee_id FK
    VARCHAR reason
    VARCHAR event_key
    DATETIME created_at
  }
  branch_memberships ||--o{ customer_service_interactions : "branch_id_employee_id"
  branches ||--o{ passes : "purchase_branch_id"
  branches ||--o{ payments : "branch_id"
  branches ||--o{ refunds : "processing_branch_id"
  customers ||--o{ customer_service_interactions : "customer_id"
  customers ||--o{ customer_status_events : "customer_id"
  customers ||--o{ passes : "customer_id"
  customers ||--o{ payments : "customer_id"
  employees ||--o{ customer_status_events : "actor_employee_id"
  employees ||--o{ pass_balance_events : "actor_employee_id"
  employees ||--o{ payments : "created_by"
  employees ||--o{ refunds : "processed_by"
  passes ||--o{ pass_balance_events : "pass_id"
  payments ||--o{ passes : "purchase_payment_id"
  payments ||--o{ refunds : "payment_id"
  products ||--o{ passes : "product_id"
  products ||--o{ payments : "product_id"
