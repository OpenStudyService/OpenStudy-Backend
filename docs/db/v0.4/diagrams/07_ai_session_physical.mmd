erDiagram
  employees {
    BIGINT id PK
  }
  ai_threads {
    BIGINT id PK
    BIGINT employee_id FK
    DATETIME created_at
    DATETIME last_used_at
  }
  ai_requests {
    BIGINT id PK
    BIGINT thread_id FK
    VARCHAR engine_request_ref
    VARCHAR engine_contract_version
    ENUM status
    DATETIME requested_at
    DATETIME finished_at
    VARCHAR error_code
  }
  SPRING_SESSION {
    CHAR PRIMARY_ID PK
    CHAR SESSION_ID
    BIGINT CREATION_TIME
    BIGINT LAST_ACCESS_TIME
    INT MAX_INACTIVE_INTERVAL
    BIGINT EXPIRY_TIME
    VARCHAR PRINCIPAL_NAME
  }
  SPRING_SESSION_ATTRIBUTES {
    CHAR SESSION_PRIMARY_ID PK,FK
    VARCHAR ATTRIBUTE_NAME PK
    BLOB ATTRIBUTE_BYTES
  }
  SPRING_SESSION ||--o{ SPRING_SESSION_ATTRIBUTES : "SESSION_PRIMARY_ID"
  ai_threads ||--o{ ai_requests : "thread_id"
  employees ||--o{ ai_threads : "employee_id"
