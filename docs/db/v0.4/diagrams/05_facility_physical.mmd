erDiagram
  branches {
    BIGINT id PK
  }
  employees {
    BIGINT id PK
  }
  customers {
    BIGINT id PK
  }
  facility_types {
    BIGINT id PK
    VARCHAR name
    SMALLINT default_inspection_days
  }
  facilities {
    BIGINT id PK
    BIGINT branch_id FK
    BIGINT type_id FK
    VARCHAR name
    VARCHAR location
    TEXT description
    ENUM status
    SMALLINT inspection_interval_days
    DATE last_inspected_on
    DATETIME created_at
    DATETIME updated_at
    BIGINT version
  }
  facility_works {
    BIGINT id PK
    BIGINT facility_id FK
    ENUM kind
    ENUM status
    VARCHAR problem
    TEXT result_note
    BIGINT assigned_employee_id FK
    BIGINT completed_by FK
    DATETIME opened_at
    DATETIME completed_at
  }
  inquiries {
    BIGINT id PK
    BIGINT branch_id FK
    BIGINT customer_id FK
    VARCHAR subject
    TEXT body
    ENUM source
    ENUM status
    BIGINT assigned_employee_id FK
    BIGINT created_by FK
    BIGINT answered_by FK
    TEXT answer_body
    DATETIME answered_at
    DATETIME created_at
    DATETIME updated_at
    BIGINT version
  }
  inquiry_events {
    BIGINT id PK
    BIGINT inquiry_id FK
    BIGINT actor_employee_id FK
    VARCHAR old_status
    VARCHAR new_status
    TEXT message
    DATETIME created_at
  }
